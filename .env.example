# FlugFinder Iran – Umgebungsvariablen
# Kopiere diese Datei als .env und fülle die Werte aus.
#
# Die Flugsuche nutzt eine Provider-Kette: erst SerpApi, und wenn dort das
# Kontingent aufgebraucht ist, automatisch Sky Scrapper. Es genügt wenn EIN
# Dienst konfiguriert ist – mit beiden bist du gegen Kontingent-Ende gewappnet.

# === SerpApi (Google Flights) – erster Suchdienst ===
# Registrierung: https://serpapi.com/users/sign_up
# API Key: https://serpapi.com/manage-api-key
# Free-Tier: 100 Suchen pro Monat
SERPAPI_API_KEY=dein_serpapi_key_hier

# === Sky Scrapper über RapidAPI (Skyscanner) – Fallback ===
# 1. Account anlegen: https://rapidapi.com
# 2. Sky Scrapper suchen und den kostenlosen Plan abonnieren
# 3. Key aus dem Reiter "Endpoints" kopieren (x-rapidapi-key)
RAPIDAPI_KEY=dein_rapidapi_key_hier
# Nur ändern wenn du eine andere Sky-Scrapper-Variante nutzt:
RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com

# === Telegram Bot ===
# 1. In Telegram: @BotFather anschreiben → /newbot → Bot-Name wählen
# 2. Bot-Token kopieren
# 3. Chat-ID: Nachricht an deinen Bot senden, dann
#    https://api.telegram.org/bot<TOKEN>/getUpdates aufrufen
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=deine_chat_id_hier
